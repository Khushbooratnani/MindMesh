# MindMesh Environment Configuration Template
APP_ENV=development

# OpenAI-Compatible Vision & LLM Endpoint
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
MEMORY_EXTRACTION_MODEL=mock-memory-extractor
IMAGE_UNDERSTANDING_MODEL=to-be-decided

# Whisper Audio Ingestion Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Multimodal File Storage & Limits
MEDIA_STORAGE_DIR=media_uploads
MAX_TEXT_LENGTH=20000
MAX_IMAGE_SIZE_MB=15
MAX_AUDIO_SIZE_MB=25

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://coeai@localhost:5432/mindmesh
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
