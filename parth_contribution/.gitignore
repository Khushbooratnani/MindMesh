# =====================================================
# MindMesh_Parth_Contribution - .gitignore
# =====================================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.cert
secrets/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
pip-log.txt

# --- Node / JavaScript ---
node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
.pnp/
.pnp.js

# --- Build Outputs ---
dist/
build/
out/
*.tsbuildinfo

# --- Databases & Dumps ---
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak
database_backups/

# --- Logs ---
*.log
logs/

# --- Temporary & OS Files ---
*.tmp
*.temp
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- IDE & Editor ---
.vscode/
.idea/
.cursor/

# --- Testing Artifacts ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml
test-results/

# --- Expo / React Native ---
.expo/
.expo-shared/
*.jks
*.p8
*.mobileprovision

# --- Zip Archives ---
*.zip
